# Copy to .env and fill in. .env is gitignored — never commit real values.

# Optional. When unset, the reasoning layer (Layer 2, free-text validation
# rules only) uses the mock provider and the pipeline still runs end to end.
# --dry-run forces mock even when set.
ANTHROPIC_API_KEY=

# Optional, only used if a future run deploys generated DDL / job JSON to a
# live workspace. Generation itself never opens a Databricks connection.
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_TOKEN=

# Optional. Directories the demo UI's documents card scans for the expected
# client reference documents (demo.input_documents in config/config.yaml).
# os.pathsep-separated (":" on POSIX, ";" on Windows); overrides the YAML
# `dirs` list — env > YAML, same as the SharePoint knobs. Machine-specific
# locations belong here, never in the tracked config.
CODEGEN_INPUT_DOCS_DIR=

# Optional. SharePoint / Microsoft Graph transport (codegen.sharepoint):
# STTM workbooks and FRD contracts in, generated artifacts out. When these
# are unset the UI hides the SharePoint panel and the sharepoint-* CLI
# commands fail loudly naming the remedy; nothing else is affected.
#
# App-only client credentials from an Entra ID app registration. Required
# Graph APPLICATION permission with admin consent: Sites.Selected on the
# target site (preferred) or Files.ReadWrite.All.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# The non-secret knobs normally live in config/config.yaml's `sharepoint:`
# section. Set them here only to override that per deployment.
# SHAREPOINT_HOST=contoso.sharepoint.com
# SHAREPOINT_SITE_PATH=/sites/DataOffice
# SHAREPOINT_LIBRARY=Documents
# SHAREPOINT_INPUT_FOLDER=
# SHAREPOINT_OUTPUT_FOLDER=
