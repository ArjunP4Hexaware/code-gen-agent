# Secrets — never commit credentials
.env
*.local.yaml

# Reference repos (siblings vendored locally for style guidance, not part of this repo)
reference/

# Generated output and run artifacts
out/
reports/

# Documents pulled from SharePoint (codegen sharepoint-fetch / the UI picker).
# These are CLIENT documents — raw or derived, they must never be tracked
# (see CLAUDE.md "Fixtures & data rules"). The landing dir is ignored whole.
inputs/

# Stray local-Spark droppings (see CLAUDE.md — delete on sight)
metastore_db/
derby.log
spark-warehouse/

# Demo UI — local state and build artifacts
ui/backend/state/
ui/frontend/node_modules/
ui/frontend/dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Office documents and FRD/STTM artifacts — blanket guard against client docs
# entering the repo. 2026-08-22: fixtures/contracts/ (incl. two contracts
# derived from REAL client FRDs), fixtures/workbooks/ and fixtures/replay/
# were deleted and git rm'd on the "no client documents in the repository"
# rule; the `!fixtures/workbooks/*.xlsx` re-include that used to live here
# was removed with them on purpose — do not add it back. Any future fixture
# material must be anonymized first AND tracked by a deliberate decision.
*.docx
*.xlsx
*.pptx
*.contract.json
fixtures/contracts/
fixtures/workbooks/
fixtures/replay/
# Deliberate exception (2026-08-31, demo-day direction from Venu): SCRUBBED
# reference fixtures produced by scripts/scrub_reference.py from the raw
# client exports in inputs/reference_raw/ (which stay ignored via inputs/).
# Only the anonymized copies under fixtures/reference/ are ever tracked;
# scripts/scrub_check.py is the denylist scanner that enforces it.
!fixtures/reference/
!fixtures/reference/*.xlsx
# Deliberate exception (2026-08-31, segmented dialect): the SYNTHETIC
# segmented golden workbook built by tests/segmented_fixture.py — zero
# client values (scrub-scanned in the suite). Everything else under
# fixtures/workbooks/ stays ignored.
!fixtures/workbooks/
fixtures/workbooks/*
!fixtures/workbooks/synthetic_segmented_golden.xlsx

# Wheel-build detritus
build/
dist/
*.whl
ui/frontend/*.tsbuildinfo

# databricks sync state (local CLI bookkeeping)
.databricks/

# Belt-and-braces (2026-09-01): no ROOT-LEVEL client document can be added
# under any extension — the two raw DDL .txt goldens once sat here untracked
# AND unignored, one `git add .` from leaking real ADLS paths. Case variants
# spelled out because gitignore matching is case-sensitive on this runner.
/*FRD*
/*frd*
/*STTM*
/*sttm*
/*SFMC*
/*sfmc*
/*RFC*
/*rfc*
/*CAQH*
/*caqh*
/*MIDS*
/*mids*

# Port-kit audit copies (evidence, inventory, scratch tooling) — local only, never shipped
port_kit_audit/

# Deliberate exception (2026-09-17, ACFC-shapes build M0): the SYNTHETIC
# fixture universe generated by scripts/build_acfc_shapes.py from
# tests/acfc_shapes/ — zero client values (scrub-scanned in the suite; the
# suite also asserts a rebuild reproduces the tracked bytes). Listed one
# file at a time, never a directory blanket. The pair_1/golden copies are
# the upstream-scrubbed golden with fixtures/acfc_shapes/ALIASES.md applied.
!fixtures/acfc_shapes/
!fixtures/acfc_shapes/sttm/pair_1_family_a.xlsx
!fixtures/acfc_shapes/pair_1/config_overlay.yaml
!fixtures/acfc_shapes/sttm/pair_8_family_a.xlsx
!fixtures/acfc_shapes/sttm/pair_2_family_b.xlsx
!fixtures/acfc_shapes/sttm/pair_3_family_c.xlsx
!fixtures/acfc_shapes/sttm/pair_4_family_d.xlsx
!fixtures/acfc_shapes/sttm/pair_6_family_d.xlsx
!fixtures/acfc_shapes/sttm/pair_5_family_e.xlsx
!fixtures/acfc_shapes/sttm/pair_7_family_e.xlsx
!fixtures/acfc_shapes/sttm/pair_9_family_e.xlsx
!fixtures/acfc_shapes/sttm/pair_10_family_e.xlsx
!fixtures/acfc_shapes/frd/f1_pair_1.docx
!fixtures/acfc_shapes/frd/f1_pair_2_variant.docx
!fixtures/acfc_shapes/frd/f2_pair_8.docx
!fixtures/acfc_shapes/vdd/pair_1_v1_segments.xlsx
!fixtures/acfc_shapes/vdd/pair_2_v2_per_file.xlsx
!fixtures/acfc_shapes/vdd/pair_9_v3_per_table.xlsx
!fixtures/acfc_shapes/pair_1/golden/RFC_ACCUMULATORS_IIG.xlsx
