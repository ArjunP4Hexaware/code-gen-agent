# (see CLAUDE.md "Fixtures & data rules"). The landing dir is ignored whole.
inputs/

# Stray local-Spark droppings (see CLAUDE.md — delete on sight)
metastore_db/
derby.log
spark-warehouse/

# Demo UI — local state and build artifacts
ui/backend/state/
ui/frontend/node_modules/
ui/frontend/dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# FRD/STTM documents and derived contracts are TRACKED as of 2026-08-28
