# Secrets — never commit credentials
.env
*.local.yaml

# Reference repos (siblings vendored locally for style guidance, not part of this repo)
reference/

# Generated output and run artifacts
out/
reports/

# Documents pulled from SharePoint (codegen sharepoint-fetch / the UI picker).
# These are CLIENT documents — raw or derived, they must never be tracked
# (see CLAUDE.md "Fixtures & data rules"). The landing dir is ignored whole.
inputs/

# Stray local-Spark droppings (see CLAUDE.md — delete on sight)
metastore_db/
derby.log
spark-warehouse/

# Demo UI — local state and build artifacts
ui/backend/state/
ui/frontend/node_modules/
ui/frontend/dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Office documents and FRD/STTM artifacts — blanket guard against client docs
# entering the repo. 2026-08-22: fixtures/contracts/ (incl. two contracts
# derived from REAL client FRDs), fixtures/workbooks/ and fixtures/replay/
# were deleted and git rm'd on the "no client documents in the repository"
# rule; the `!fixtures/workbooks/*.xlsx` re-include that used to live here
# was removed with them on purpose — do not add it back. Any future fixture
# material must be anonymized first AND tracked by a deliberate decision.
*.docx
*.xlsx
*.contract.json
fixtures/contracts/
fixtures/workbooks/
fixtures/replay/

# Wheel-build detritus
build/
dist/
*.whl
ui/frontend/*.tsbuildinfo
