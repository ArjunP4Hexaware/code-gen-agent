#!/bin/sh
# pre-push (2026-10-12): a push to a branch the ACFC App or harness deploys from
# must carry a NEW version marker whenever it changes code, so the App's health
# line can never name two different trees with one version ("0.5.8.post26" named
# f37d1a1 and the six commits pushed after it without a bump).
#
# Install once per clone:   git config core.hooksPath scripts/git-hooks
# Bump the marker:          python scripts/bump_version.py   (then commit)
#
# Refused, for a deploy branch, when the pushed range changes code and
#   * pyproject.toml's version equals the one on the remote tip, or
#   * requirements.txt's codegen-version-marker differs from pyproject's, or
#   * the pushed tree TRACKS src/codegen/_build.py (the deploy stamp is written
#     at deploy by scripts/stamp_build.py, never committed).
# A new branch, a deletion and any other branch pass untouched.

DEPLOY_BRANCHES="refs/heads/feature/multi-table refs/heads/feature/iig-first"
CODE_PATHS="src ui/backend ui/frontend/src ui/frontend/dist config requirements.txt pyproject.toml app.yaml acfc_run.py"
ZERO=0000000000000000000000000000000000000000

version_at() {   # <sha>: pyproject version
    git show "$1:pyproject.toml" 2>/dev/null | tr -d '\r' | sed -n 's/^version = "\(.*\)"$/\1/p' | head -n 1
}
marker_at() {    # <sha>: requirements.txt marker
    git show "$1:requirements.txt" 2>/dev/null | tr -d '\r' | sed -n 's/^# codegen-version-marker: \(.*\)$/\1/p' | head -n 1
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case " $DEPLOY_BRANCHES " in
        *" $remote_ref "*) ;;
        *) continue ;;
    esac
    [ "$local_sha" = "$ZERO" ] && continue                 # a deletion
    branch=${remote_ref#refs/heads/}
    if [ -n "$(git ls-tree -r --name-only "$local_sha" -- src/codegen/_build.py)" ]; then
        echo "pre-push: refused ($branch): src/codegen/_build.py is tracked — it is a deploy stamp" >&2
        echo "  (scripts/stamp_build.py writes it at deploy). git rm --cached it and commit." >&2
        status=1
        continue
    fi
    [ "$remote_sha" = "$ZERO" ] && continue                # a new branch: nothing to compare
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        echo "pre-push: refused ($branch): the remote tip $remote_sha is not here — git fetch first" >&2
        status=1
        continue
    fi
    # shellcheck disable=SC2086 — CODE_PATHS is a word list on purpose
    changed=$(git diff --name-only "$remote_sha" "$local_sha" -- $CODE_PATHS)
    [ -z "$changed" ] && continue                          # docs / tools / tests only
    old=$(version_at "$remote_sha")
    new=$(version_at "$local_sha")
    marker=$(marker_at "$local_sha")
    if [ "$new" = "$old" ]; then
        echo "pre-push: refused ($branch): code changed since ${remote_sha%"${remote_sha#???????}"} but the version is still $old." >&2
        echo "  Run: python scripts/bump_version.py && git commit -am 'chore: marker <new>'  — then push again." >&2
        echo "  Changed:" >&2
        echo "$changed" | head -n 10 | sed 's/^/    /' >&2
        status=1
    elif [ "$marker" != "$new" ]; then
        echo "pre-push: refused ($branch): requirements.txt marker '$marker' != pyproject version '$new'" >&2
        echo "  (the Apps runtime caches its install on requirements.txt). Run: python scripts/bump_version.py --sync" >&2
        status=1
    fi
done
exit $status
