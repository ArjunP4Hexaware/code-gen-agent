{#- post159 (P1-4, CS-2): every value is one '#' line (|comment1) - a line break in
    document text can never end the comment and become generated code. #}
{% macro banner(provenance, feed) -%}
# GENERATED by codegen-data-engineer-agent — DO NOT EDIT BY HAND.
# Feed: {{ feed.id | comment1 }} ({{ feed.name | comment1 }})
# FRD contract:
#   {{ provenance.frd_name | comment1 }}
#   sha256 {{ provenance.frd_sha[:16] }}
# STTM contract: sha256 {{ provenance.sttm_sha[:16] }}
{% if provenance.synthetic %}
# WARNING: the STTM contract is SYNTHETIC — regenerate when the real mapping
# workbook extract lands (see fixtures/contracts/*SYNTHETIC*.json notes).
{% endif %}
# Inputs (three-input model):
#   STTM contract ........ {{ provenance.sttm_sha[:16] }}
#   Engineering standards  {{ provenance.inputs.standards_status | comment1 }}
#   Load-pattern FAQ ..... {{ provenance.inputs.answered }} answered ({{ provenance.inputs.from_contract }} from contract), {{ provenance.inputs.unknown }} unknown
{% if provenance.inputs.dataset_source or provenance.inputs.dataset_target %}
#   Collibra dataset IDs . source={{ (provenance.inputs.dataset_source or "?") | comment1 }} target={{ (provenance.inputs.dataset_target or "?") | comment1 }}
{% else %}
#   Collibra dataset IDs . not yet integrated (planned)
{% endif %}
# Declared load mode: {{ provenance.inputs.load_mode | comment1 }} (source: {{ provenance.inputs.load_mode_source | comment1 }})
# Write behavior in this version: {{ provenance.inputs.writer_behavior | comment1 }} (load-mode branching: v2)
{%- if provenance.segmented %}

# Segmented extraction ({{ provenance.segmented.method | comment1 }}):
#   trailer marker {{ provenance.segmented.trailer_marker | comment1 }}; header = {{ provenance.segmented.header_rule | comment1 }}; detail = the rest
{%- endif %}
{%- endmacro %}

{% macro pylist(items, indent_spaces=4) -%}
[
{% for item in items %}
{{ " " * indent_spaces }}{{ item | tojson }},
{% endfor %}
]
{%- endmacro %}
