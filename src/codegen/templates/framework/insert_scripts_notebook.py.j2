# Databricks notebook source
# TARGET SYSTEM = SQL Server metadata DB
# RUN FROM = Databricks notebook
# ENVIRONMENT = {{ env }}
# GENERATED by codegen-data-engineer-agent. Runs {{ sql_name }} (the same
# directory) against the framework's metadata database over JDBC, in ONE
# transaction: every INSERT lands or none does. Rules: {{ semantics }}.
#
# {{ sql_name }} carries one <<COLUMN#n>> placeholder per open cell (an
# engineer-assigned id, an environment value, an audit stamp): replace every
# one in the file before running — this notebook refuses to send anything
# while a placeholder is left.
#
# Nothing here is a credential: the JDBC url, user and password are read
# from the Databricks secret scope named below (config dml.secret_scope).

# COMMAND ----------

import os
import re

SQL_NAME = "{{ sql_name }}"
# Names of the secret scope and its keys — the values live in Databricks.
SECRET_SCOPE = "{{ secret_scope }}"
KEY_NAME_JDBC_URL = "{{ jdbc_url_secret }}"
KEY_NAME_JDBC_USER = "{{ user_secret }}"
KEY_NAME_JDBC_AUTH = "{{ password_secret }}"
PLACEHOLDER = re.compile(r"<<[A-Za-z0-9_]+(?:#\d+)?>>")

dbutils.widgets.text("sql_dir", "", "directory holding the .sql (blank = notebook dir)")  # noqa: F821

# COMMAND ----------

sql_dir = dbutils.widgets.get("sql_dir").strip()  # noqa: F821
if not sql_dir:
    sql_dir = os.path.dirname(
        dbutils.notebook.entry_point.getDbutils().notebook().getContext().notebookPath().get())  # noqa: F821
    sql_dir = "/Workspace" + sql_dir if not sql_dir.startswith("/Workspace") else sql_dir
with open(os.path.join(sql_dir, SQL_NAME), encoding="utf-8") as handle:
    script = handle.read()

left = sorted(set(PLACEHOLDER.findall(script)))
if left:
    raise ValueError(f"{SQL_NAME}: {len(left)} placeholder(s) not filled — replace every "
                     "<<COLUMN#n>> before running: " + ", ".join(left[:20])
                     + (" …" if len(left) > 20 else ""))
print(f"{SQL_NAME}: {len(script.splitlines())} lines; no placeholder left")

# COMMAND ----------

url = dbutils.secrets.get(SECRET_SCOPE, KEY_NAME_JDBC_URL)  # noqa: F821
user = dbutils.secrets.get(SECRET_SCOPE, KEY_NAME_JDBC_USER)  # noqa: F821
credential = dbutils.secrets.get(SECRET_SCOPE, KEY_NAME_JDBC_AUTH)  # noqa: F821

jvm = spark._sc._jvm  # noqa: F821
connection = jvm.java.sql.DriverManager.getConnection(url, user, credential)
connection.setAutoCommit(False)
try:
    statement = connection.createStatement()
    has_result_set = statement.execute(script)
    while True:
        if has_result_set:
            rs = statement.getResultSet()
            while rs.next():
                print(f"{rs.getString(1)}: {rs.getInt(2)} row(s) inserted")
        else:
            count = statement.getUpdateCount()
            if count == -1:
                break
        has_result_set = statement.getMoreResults()
    connection.commit()
    print("committed")
except Exception:
    connection.rollback()
    print("rolled back — nothing was inserted")
    raise
finally:
    connection.close()
