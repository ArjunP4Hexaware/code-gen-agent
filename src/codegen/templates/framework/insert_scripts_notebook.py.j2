# Databricks notebook source
# TARGET SYSTEM = SQL Server metadata DB
# RUN FROM = Databricks notebook
# ENVIRONMENT = {{ env }}
# GENERATED by codegen-data-engineer-agent. Runs {{ sql_name }} (the same
# directory) against the framework's metadata database over JDBC, in ONE
# transaction: every INSERT lands or none does. Rules: {{ semantics }}.
#
# Nothing here is a credential: the JDBC url, user and password are read
# from the Databricks secret scope named below (config dml.secret_scope).
# The engineer-assigned ids arrive as widgets; a widget left blank keeps
# the value the script declares (a FAQ answer) — an id that is still
# unassigned stops the run before anything is sent.

# COMMAND ----------

import os
import re

SQL_NAME = "{{ sql_name }}"
# Names of the secret scope and its keys — the values live in Databricks.
SECRET_SCOPE = "{{ secret_scope }}"
KEY_NAME_JDBC_URL = "{{ jdbc_url_secret }}"
KEY_NAME_JDBC_USER = "{{ user_secret }}"
KEY_NAME_JDBC_AUTH = "{{ password_secret }}"
VARIABLES = [
{% for name in variables %}
    "{{ name }}",
{% endfor %}
]
INT_VARIABLES = [
{% for name in int_variables %}
    "{{ name }}",
{% endfor %}
]

for name in VARIABLES:
    dbutils.widgets.text(name, "", f"@{name} (blank = keep the script's value)")  # noqa: F821
dbutils.widgets.text("sql_dir", "", "directory holding the .sql (blank = notebook dir)")  # noqa: F821

# COMMAND ----------

sql_dir = dbutils.widgets.get("sql_dir").strip()  # noqa: F821
if not sql_dir:
    sql_dir = os.path.dirname(
        dbutils.notebook.entry_point.getDbutils().notebook().getContext().notebookPath().get())  # noqa: F821
    sql_dir = "/Workspace" + sql_dir if not sql_dir.startswith("/Workspace") else sql_dir
with open(os.path.join(sql_dir, SQL_NAME), encoding="utf-8") as handle:
    script = handle.read()

# Widget values replace the DECLARE line's value. Integers only for the id
# variables; the RFC number and host / path are validated as plain tokens.
def _substitute(text: str, name: str, value: str) -> str:
    value = value.strip()
    if name in INT_VARIABLES:
        if not re.fullmatch(r"-?\d+", value):
            raise ValueError(f"@{name} must be an integer, got {value!r}")
        rendered = value
    else:
        if not re.fullmatch(r"[A-Za-z0-9_./\\:@-]+", value):
            raise ValueError(f"@{name} may hold only [A-Za-z0-9_./\\:@-], got {value!r}")
        rendered = "N'" + value.replace("'", "''") + "'"
    pattern = re.compile(
        rf"^(DECLARE @{name} \S+(?: ?\(\d+\))? = )(NULL|N'[^']*'|-?\d+);(\s+-- ASSIGN)?",
        re.MULTILINE)
    text, n = pattern.subn(rf"\g<1>{rendered};", text)
    if n != 1:
        raise ValueError(f"@{name}: expected exactly one DECLARE line, found {n}")
    return text

for name in VARIABLES:
    value = dbutils.widgets.get(name)  # noqa: F821
    if value.strip():
        script = _substitute(script, name, value)

unassigned = re.findall(r"^DECLARE @(\w+) [^=]+= NULL;\s+-- ASSIGN", script, re.MULTILINE)
required = [n for n in unassigned if n in ("RFC_NUMBER", "PIPELINE_ID", "GROUP_ID")]
if required:
    raise ValueError("unassigned variables (set the widgets or answer the FAQ): "
                     + ", ".join("@" + n for n in required))
print(f"{SQL_NAME}: {len(script.splitlines())} lines; unassigned (optional): {unassigned}")

# COMMAND ----------

url = dbutils.secrets.get(SECRET_SCOPE, KEY_NAME_JDBC_URL)  # noqa: F821
user = dbutils.secrets.get(SECRET_SCOPE, KEY_NAME_JDBC_USER)  # noqa: F821
credential = dbutils.secrets.get(SECRET_SCOPE, KEY_NAME_JDBC_AUTH)  # noqa: F821

jvm = spark._sc._jvm  # noqa: F821
connection = jvm.java.sql.DriverManager.getConnection(url, user, credential)
connection.setAutoCommit(False)
try:
    statement = connection.createStatement()
    has_result_set = statement.execute(script)
    while True:
        if has_result_set:
            rs = statement.getResultSet()
            while rs.next():
                print(f"{rs.getString(1)}: {rs.getInt(2)} row(s) inserted")
        else:
            count = statement.getUpdateCount()
            if count == -1:
                break
        has_result_set = statement.getMoreResults()
    connection.commit()
    print("committed")
except Exception:
    connection.rollback()
    print("rolled back — nothing was inserted")
    raise
finally:
    connection.close()
