{
  "_generated_by": "codegen-data-engineer-agent — DO NOT EDIT BY HAND",
  "_feed": {{ feed.id | tojson }},
  "_frd_sha256": {{ provenance.frd_sha | tojson }},
  "_sttm_sha256": {{ provenance.sttm_sha | tojson }},
  "_sla_from_contract": {{ sla_texts | tojson }},
  "name": {{ job_name | tojson }},
  "tasks": [
    {
      "task_key": {{ job_name | tojson }},
      "notebook_task": {
        "notebook_path": "/Workspace/pipelines/{{ feed.slug }}/{{ workspace_notebook_name }}",
        "base_parameters": {
          "lob": {{ lobs[0] | tojson }},
          "catalog": {{ (default_catalog or "") | tojson }},
          "file_path": "",
          "run_ts": ""
        }
      },
      "timeout_seconds": {{ job.timeout_seconds }},
      "job_cluster_key": "ingest_cluster"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "ingest_cluster",
      "new_cluster": {
        "spark_version": {{ job.spark_version | tojson }},
        "node_type_id": {{ job.node_type_id | tojson }},
        "num_workers": {{ job.num_workers }}{% if job.runtime_engine %},
        "runtime_engine": {{ job.runtime_engine | tojson }}{% endif +%}
      }
    }
  ],
  "timeout_seconds": {{ job.timeout_seconds }},
{% if schedule %}
  "schedule": {
    "quartz_cron_expression": {{ schedule.quartz_cron_expression | tojson }},
    "timezone_id": {{ schedule.timezone_id | tojson }},
    "pause_status": "PAUSED"
  },
{% else %}
  "_schedule_note": "SLA text was not unambiguously translatable to cron; schedule manually from _sla_from_contract.",
{% endif %}
{% if notifications.rule_texts %}
  "_notification_rules_from_contract": {{ notifications.rule_texts | tojson }},
{% endif %}
  "email_notifications": {
    "on_success": {{ notifications.emails | tojson }},
    "on_failure": {{ notifications.emails | tojson }}
  },
  "max_concurrent_runs": 1
}
