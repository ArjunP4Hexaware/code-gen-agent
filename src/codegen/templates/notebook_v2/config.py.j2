def adls_uri(container: str, path: str) -> str:
    """The abfss:// address of ``path`` in ``container`` on STORAGE_ACCOUNT."""
    if "://" in path:
        return path
    return f"abfss://{container}@{STORAGE_ACCOUNT}.{_ADLS_HOST}/{path.lstrip('/')}"


def tally(step: str, target: str, rows: int) -> None:
    """One run-report row: ``rows`` at ``step`` for ``target``."""
    RUN_REPORT.append({"step": step, "target": target, "rows": int(rows)})


def table_name(catalog: str, schema: str, table: str) -> str:
    """catalog.schema.table — with the _dryrun suffix under dry_run."""
    name = ".".join(part for part in (catalog, schema, table) if part)
    return name + DRY_RUN_SUFFIX if DRY_RUN else name
