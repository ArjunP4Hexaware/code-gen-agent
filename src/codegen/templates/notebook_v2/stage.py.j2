_AUDIT_RULES = {{ audit_rules | block }}


def with_audit(df: DataFrame, source: dict, names: list[str]) -> DataFrame:
    """The profile's audit columns: the file's LOB, its name, the load time."""
    values = {
        "lob": F.lit(source["lob"] or None).cast("string"),
        "file_name": F.element_at(F.split("_source_file", "/"), -1),
        "timestamp": F.current_timestamp(),
    }
    columns = {name: values[_AUDIT_RULES[name]] for name in names
               if name in _AUDIT_RULES}
    df = df.withColumns(columns) if columns else df
    return df.drop("_source_file")


def write_table(df: DataFrame, target: str, row: dict) -> None:
    """TGT_LOAD_OPTION (Overwrite / Append{% if needs_merge %} / Upsert{% endif %}) with
    the row's TGT_PARTITION_COLUMN / TGT_PARTITION_VALUE{% if needs_merge %} and
    TGT_PRIMARY_KEY{% endif %}."""
    option = row["load_option"].lower()
{% if needs_merge %}
    if option in ("upsert", "merge"):
        if not row["primary_key"]:
            raise ValueError(
                f"{target}: {row['load_option']} needs TGT_PRIMARY_KEY"
            )
        if not spark.catalog.tableExists(target):
            df.write.format("delta").saveAsTable(target)
            return
        condition = " AND ".join(
            f"t.{key} = s.{key}" for key in row["primary_key"]
        )
        table = DeltaTable.forName(spark, target).alias("t")
        merge = table.merge(df.alias("s"), condition)
        merge.whenMatchedUpdateAll().whenNotMatchedInsertAll().execute()
        tally(f"written ({row['load_option']})", target, df.count())
        return
{% endif %}
    if option not in ("overwrite", "append"):
        raise ValueError(
            f"{target}: TGT_LOAD_OPTION {row['load_option']!r} is not handled"
        )
    writer = df.write.format("delta").mode(option)
    # TGT_PARTITION_COLUMN / _VALUE scope an overwrite to the file's
    # rows (replaceWhere on a data column); never partitionBy: the DDL
    # clusters the table, and Delta clustering is not compatible with
    # partitioning
    if (row["partition_column"] and option == "overwrite"
            and row["partition_value"] not in ("", "NA")):
        where = f"{row['partition_column']} = '{row['partition_value']}'"
        writer = writer.option("replaceWhere", where)
    writer.saveAsTable(target)
    tally(f"written ({row['load_option']})", target, df.count())


def cast_to_types(
    df: DataFrame, columns: list[str], types: list[str], target: str
) -> DataFrame:
    """Each column to its TGT_DATA_TYPE - the STTM's stage types, as the DDL
    creates the table. A non-blank value the type cannot read would load as
    NULL: the load stops instead, naming the column and the rows. char /
    varchar(n) cast as string (the table's own column type holds the
    length)."""
    typed = {}
    for column, data_type in zip(columns, types, strict=False):
        if data_type and column in df.columns:
            spelled = data_type.strip().lower()
            text = spelled.startswith(("char", "varchar"))
            typed[column] = "string" if text else spelled
    if not typed:
        return df
    cast = {
        column: F.col(column).cast(data_type)
        for column, data_type in typed.items()
    }
    blank = {
        column: F.trim(F.col(column).cast("string")) != "" for column in cast
    }
    # one aggregate over the records: the unreadable values per column
    counts = df.select(
        [
            F.sum(F.when(blank[c] & e.isNull(), 1).otherwise(0)).alias(c)
            for c, e in cast.items()
        ]
    ).first()
    lost = {column: rows for column, rows in counts.asDict().items() if rows}
    if lost:
        raise ValueError(
            f"{target}: values the stage data type cannot read (they"
            " would load as NULL): "
            + "; ".join(
                f"{column} as {typed[column]}: {rows} row(s)"
                for column, rows in lost.items()
            )
        )
    return df.withColumns(cast)


def stage_frame(df: DataFrame, source: dict) -> DataFrame:
    """The detail records with the audit columns, in TGT_COLUMN_NAMES
    order, cast to TGT_DATA_TYPE (stage columns keep the types the STTM
    states)."""
    df = with_audit(df.drop("_recycled_at"), source, AUDIT_COLUMNS)
    if source["target_columns"]:
        df = df.select(*source["target_columns"])
    return cast_to_types(df, source["target_columns"], source["target_types"],
                         f"{source['schema']}.{source['table']}")


def write_stage(df: DataFrame, source: dict) -> None:
    """ADLS_DELTA TGT_DATABASE_NAME.TGT_TABLE_NAME in STAGE_CATALOG."""
    target = table_name(STAGE_CATALOG, source["schema"], source["table"])
    write_table(df, target, source)
