"""Audit columns — pipeline-populated, never sourced from the file.

LOB is a run parameter, SRC_FILE_NAME is the actual ingested file name, and
the REC_*_TIME columns come from the injectable ``run_ts`` so recycle aging
and backfills are deterministic and testable. ``REC_CREATION_TIME`` is
preserved across re-ingests by the MERGE in ``writer.py``.
"""
{{ banner(provenance, feed) }}

from __future__ import annotations

from datetime import datetime

from pyspark.sql import DataFrame
from pyspark.sql import functions as F

from pipeline import feed_spec

LOB_COLUMN = "LOB"
SRC_FILE_NAME_COLUMN = "SRC_FILE_NAME"
REC_CREATION_TIME_COLUMN = "REC_CREATION_TIME"
REC_UPDATED_TIME_COLUMN = "REC_UPDATED_TIME"
{% if has_file_type_audit %}
# This feed's contract declares a FILE_TYPE audit column: populated with the
# feed's static file format (pipeline-populated, never sourced from the file).
FILE_TYPE_COLUMN = "FILE_TYPE"
{% endif %}


class UnknownLobError(ValueError):
    """The run's LOB parameter is not one the contract declares."""


def check_lob(lob: str) -> str:
    if lob not in feed_spec.LOBS:
        raise UnknownLobError(f"LOB '{lob}' is not one of the contract's LOBs {feed_spec.LOBS}")
    return lob


def add_audit_columns(
    df: DataFrame, lob: str, src_file_name: str, run_ts: datetime
) -> DataFrame:
    check_lob(lob)
    timestamp = F.lit(run_ts).cast("timestamp")
    return (
        df.withColumn(LOB_COLUMN, F.lit(lob))
        .withColumn(SRC_FILE_NAME_COLUMN, F.lit(src_file_name))
{% if has_file_type_audit %}
        .withColumn(FILE_TYPE_COLUMN, F.lit(feed_spec.FILE_FORMAT))
{% endif %}
        .withColumn(REC_CREATION_TIME_COLUMN, timestamp)
        .withColumn(REC_UPDATED_TIME_COLUMN, timestamp)
    )
