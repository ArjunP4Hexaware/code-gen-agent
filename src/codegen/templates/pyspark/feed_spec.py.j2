def qualified(table: str, catalog: str | None = DEFAULT_CATALOG, schema: str = STAGE_SCHEMA) -> str:
    """Fully qualified table name; two-part when no catalog (local runs)."""
    parts = [catalog, schema, table] if catalog else [schema, table]
    return ".".join(parts)


def matches_file(file_name: str) -> bool:
    return any(rx.match(file_name) for rx in _FILE_NAME_REGEXES)


def _create_table_sql(name: str, columns: list[tuple[str, str]]) -> str:
    column_sql = ", ".join(f"`{col}` {dtype}" for col, dtype in columns)
    return f"CREATE TABLE IF NOT EXISTS {name} ({column_sql}) USING DELTA"


def stage_table_columns(segment: str) -> list[tuple[str, str]]:
    """Stage tables: all source columns as STRING + typed audit columns."""
    data_columns = [(col, "STRING") for col in SEGMENTS[segment]["stage_columns"]]
    return data_columns + AUDIT_COLUMNS


def ensure_tables(spark: SparkSession, catalog: str | None = DEFAULT_CATALOG) -> None:
    """Create the schema and every table this pipeline writes, if missing."""
    schema_name = f"{catalog}.{STAGE_SCHEMA}" if catalog else STAGE_SCHEMA
    spark.sql(f"CREATE DATABASE IF NOT EXISTS {schema_name}")
    for segment in SEGMENTS:
        table = qualified(SEGMENTS[segment]["stage_table"], catalog)
        spark.sql(_create_table_sql(table, stage_table_columns(segment)))
    spark.sql(_create_table_sql(qualified(ERRORS_TABLE, catalog), ERRORS_COLUMNS))
    spark.sql(
        _create_table_sql(qualified(PROCESSED_FILES_TABLE, catalog), PROCESSED_FILES_COLUMNS)
    )
{% if recycle %}
    recycle_columns = stage_table_columns(DETAIL_SEGMENT) + RECYCLE_STATUS_COLUMNS
    spark.sql(_create_table_sql(qualified(RECYCLE_TABLE, catalog), recycle_columns))
{% endif %}
