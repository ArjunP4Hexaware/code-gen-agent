"""End-to-end: land -> load -> DQ -> report for one file."""
{{ banner(provenance, feed) }}

from conftest import RUN_TS, detail_rows, write_source_file
from pipeline import feed_spec, orchestrator


def _ingest(spark, path, **kwargs):
    return orchestrator.ingest_file(
        spark,
        str(path),
        feed_spec.LOBS[0],
        run_ts=RUN_TS,
        catalog=None,
        **kwargs,
    )


{% if recycle %}
def test_happy_path_loads_and_passes_dq(spark, tables, reference_stand_in, tmp_path):
    from conftest import add_reference_ids

    rows = detail_rows(3, key_prefix="E2E")
    add_reference_ids(spark, [r[{{ detail_natural_key_source_columns[0] | tojson }}] for r in rows])
    path = write_source_file(
        tmp_path, rows, file_name={{ e2e_file_names[0] | tojson }}
    )
    result = _ingest(spark, path, reference_table=reference_stand_in, report_dir=str(tmp_path))
    assert result.status == orchestrator.STATUS_LOADED, result
    assert result.rows_loaded == 3
    assert result.rows_recycled == 0
    assert (tmp_path / f"{feed_spec.FEED_ID}__{result.src_file_name.replace('.', '_')}.md").exists()


def test_unknown_member_rows_are_recycled(spark, tables, reference_stand_in, tmp_path):
    rows = detail_rows(2, key_prefix="E2EUNK")
    path = write_source_file(
        tmp_path, rows, file_name={{ e2e_file_names[1] | tojson }}
    )
    result = _ingest(spark, path, reference_table=reference_stand_in)
    assert result.rows_loaded == 0
    assert result.rows_recycled == 2
