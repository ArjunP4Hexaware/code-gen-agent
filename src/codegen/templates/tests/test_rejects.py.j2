{% from "_macros.py.j2" import banner %}
"""Not-null rejects land in the errors table; PHI keys arrive masked."""
{{ banner(provenance, feed) }}

{% set phi_key_test = phi_columns and natural_key | length > 1 and natural_key[0] in phi_columns %}
from conftest import RUN_TS, detail_rows, sample_row
{% if phi_key_test %}
from pipeline import audit, feed_spec, mapping, masking, rejects
{% else %}
from pipeline import audit, feed_spec, mapping, rejects
{% endif %}


def _audited_frame(spark, rows):
    columns = list(rows[0])
    df = spark.createDataFrame([tuple(r[c] for c in columns) for r in rows], columns)
    return audit.add_audit_columns(
        mapping.map_to_stage(df), feed_spec.LOBS[0], "test_rejects_file", RUN_TS
    )


def _null_key_row():
    row = sample_row()
    key_source = {{ detail_natural_key_source_columns[0] | tojson }}
    row[key_source] = ""
    return row


def test_split_rejects_separates_blank_keys(spark):
    df = _audited_frame(spark, [*detail_rows(2), _null_key_row()])
    good, rejected = rejects.split_rejects(df)
    assert good.count() == 2
    assert rejected.count() == 1


def test_write_rejects_appends_to_errors_table(spark, tables, tmp_path):
    df = _audited_frame(spark, [_null_key_row()])
    _good, rejected = rejects.split_rejects(df)
    written = rejects.write_rejects(
        spark, rejected, feed_spec.LOBS[0], "test_rejects_file", RUN_TS, catalog=None
    )
    assert written == 1
    errors = (
        spark.table(feed_spec.qualified(feed_spec.ERRORS_TABLE, catalog=None))
        .where("SRC_FILE_NAME = 'test_rejects_file'")
        .collect()
    )
    assert len(errors) == 1
    assert errors[0]["ERROR_TYPE"] == rejects.ERROR_TYPE_NOT_NULL


{% if phi_key_test %}
def test_rejected_phi_key_is_masked(spark, tables):
    row = sample_row()
    phi_source = {{ detail_natural_key_source_columns[0] | tojson }}
    other_key_sources = [
        c for c in {{ detail_natural_key_source_columns | tojson }} if c != phi_source
    ]
    row[phi_source] = "SENSITIVE123456"
    for column in other_key_sources:
        row[column] = ""
    df = _audited_frame(spark, [row])
    _good, rejected = rejects.split_rejects(df)
    rejects.write_rejects(
        spark, rejected, feed_spec.LOBS[0], "test_rejects_phi", RUN_TS, catalog=None
    )
    errors = (
        spark.table(feed_spec.qualified(feed_spec.ERRORS_TABLE, catalog=None))
        .where("SRC_FILE_NAME = 'test_rejects_phi'")
        .collect()
    )
    assert errors
    for record in errors:
        assert "SENSITIVE123456" not in record["KEY_VALUE_MASKED"]
        assert record["KEY_VALUE_MASKED"] == masking.mask_value("SENSITIVE123456")
{% else %}
def test_rejected_key_value_recorded(spark, tables):
    df = _audited_frame(spark, [_null_key_row()])
    _good, rejected = rejects.split_rejects(df)
    rejects.write_rejects(
        spark, rejected, feed_spec.LOBS[0], "test_rejects_key", RUN_TS, catalog=None
    )
    errors = (
        spark.table(feed_spec.qualified(feed_spec.ERRORS_TABLE, catalog=None))
        .where("SRC_FILE_NAME = 'test_rejects_key'")
        .collect()
    )
    assert errors and errors[0]["KEY_VALUE_MASKED"] is not None
{% endif %}
